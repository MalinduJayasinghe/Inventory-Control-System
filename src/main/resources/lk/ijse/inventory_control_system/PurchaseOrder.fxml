<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640" prefWidth="880" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.inventory_control_system.controllers.PurchaseOrderController">
    
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #f1f5f9; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox spacing="18" style="-fx-padding: 20;">
                
                <!-- Purchase Order Form Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 18px; -fx-font-weight: bold;" text="🛒 Create Purchase Order" />
                    
                    <HBox spacing="20">
                        
                        <!-- Left Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Supplier Selection -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Supplier" />
                                <ComboBox fx:id="supplierComboBox" maxWidth="250.0" prefHeight="32" promptText="Select Supplier" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Item Selection -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Item" />
                                <ComboBox fx:id="itemComboBox" maxWidth="250.0" prefHeight="32" promptText="Select Item" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Quantity -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Quantity" />
                                <TextField fx:id="quantityField" maxWidth="250.0" prefHeight="32" promptText="Enter Quantity" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                        </VBox>
                        
                        <!-- Right Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Unit Price -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Unit Price" />
                                <TextField fx:id="unitPriceField" maxWidth="250.0" prefHeight="32" promptText="Enter Unit Price" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Order Date -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Order Date" />
                                <DatePicker fx:id="orderDatePicker" maxWidth="250.0" prefHeight="32" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Action Buttons -->
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox.margin>
                                    <Insets top="5" />
                                </VBox.margin>
                                
                                <Button onAction="#addItemToTable" prefHeight="34" prefWidth="110" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Add Item" />
                                
                                <Button onAction="#resetFields" prefHeight="34" prefWidth="100" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Reset" />
                            </HBox>
                            
                        </VBox>
                        
                    </HBox>
                    
                </VBox>
                
                <!-- Purchase Order Items Table Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 16px; -fx-font-weight: bold;" text="📋 Order Items" />
                    
                    <TableView fx:id="purchaseOrderTable" prefHeight="220" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="colItemName" prefWidth="200" style="-fx-alignment: CENTER-LEFT;" text="Item Name" />
                            <TableColumn fx:id="colUnitPrice" prefWidth="130" style="-fx-alignment: CENTER;" text="Unit Price" />
                            <TableColumn fx:id="colQty" prefWidth="100" style="-fx-alignment: CENTER;" text="Quantity" />
                            <TableColumn fx:id="colTotalPrice" prefWidth="130" style="-fx-alignment: CENTER;" text="Total Price" />
                            <TableColumn fx:id="colAction" prefWidth="150" style="-fx-alignment: CENTER;" text="Action" />
                        </columns>
                    </TableView>
                    
                    <!-- Total and Place Order Section -->
                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <VBox.margin>
                            <Insets top="5" />
                        </VBox.margin>
                        
                        <!-- Total Display -->
                        <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #f1f5f9; -fx-padding: 10 20; -fx-background-radius: 8;">
                            <Label style="-fx-text-fill: #475569; -fx-font-size: 14px; -fx-font-weight: bold;" text="Total Amount:" />
                            <Label fx:id="lblTotal" style="-fx-text-fill: #3b82f6; -fx-font-size: 18px; -fx-font-weight: bold;" text="Rs. 0.00" />
                        </HBox>
                        
                        <!-- Place Order Button -->
                        <Button onAction="#placePurchaseOrder" prefHeight="42" prefWidth="160" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.3), 10, 0.3, 0, 3);" text="🚀 Place Order" />
                        
                    </HBox>
                    
                </VBox>
                
            </VBox>
        </content>
    </ScrollPane>
    
</AnchorPane>
