<jasperReport name="purchaseOrder" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ad341da4-a8cf-4513-a5ab-caebafea0e62">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="New Data Adapter (2)"/>
	<parameter name="orderId" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT
    i.Item_ID,
    i.ItemName,
    poi.p_order_id,
    poi.unit_price AS UnitPrice,
    poi.qty AS Quantity,
    po.OrderDate,
    s.Supplier_ID,
    s.SupplierName
FROM
    PurchaseOrderItem poi
JOIN Items i ON poi.item_id = i.Item_ID
JOIN PurchaseOrder po ON poi.p_order_id = po.P_Order_ID
JOIN Suppliers s ON po.Supplier_ID = s.Supplier_ID
WHERE po.P_Order_ID = $P{orderId}
ORDER BY
    po.OrderDate, i.ItemName;]]></query>
