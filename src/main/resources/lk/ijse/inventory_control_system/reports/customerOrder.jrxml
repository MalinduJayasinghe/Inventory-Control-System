<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="customerOrder" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1c4e92f-6d34-4e7b-baf4-2c7e9f3b0a61">
	<parameter name="orderId" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[
SELECT
    i.Item_ID,
    i.ItemName,
    coi.c_order_id,
    coi.unit_price AS UnitPrice,
    coi.qty AS Quantity,
    co.Date AS OrderDate,
    c.Customer_ID,
    c.CustomerName
FROM CustomerOrderItem coi
JOIN Items i ON coi.item_id = i.Item_ID
JOIN CustomerOrder co ON coi.c_order_id = co.Order_ID
JOIN Customer c ON co.Customer_ID = c.Customer_ID
WHERE co.Order_ID = $P{orderId}
ORDER BY co.Date, i.ItemName
    ]]></query>
	<field name="Item_ID" class="java.lang.Integer"/>
	<field name="ItemName" class="java.lang.String"/>
	<field name="c_order_id" class="java.lang.Integer"/>
	<field name="UnitPrice" class="java.lang.Double"/>
	<field name="Quantity" class="java.lang.Integer"/>
	<field name="OrderDate" class="java.sql.Date"/>
	<field name="Customer_ID" class="java.lang.Integer"/>
	<field name="CustomerName" class="java.lang.String"/>
	<variable name="TotalCost" calculation="Sum" class="java.lang.Double">
		<expression><![CDATA[$F{UnitPrice} * $F{Quantity}]]></expression>
	</variable>
