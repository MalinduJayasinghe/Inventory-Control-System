<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="1100"
            xmlns="http://javafx.com/javafx/13" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="lk.ijse.inventory_control_system.controllers.DashboardController">

    <left>
        <VBox prefWidth="260" spacing="20" style="-fx-background-color: #2C3E50; -fx-padding: 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Dashboard" />

            <Button fx:id="Items" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Items" />

            <Button fx:id="DamagedItems" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Damaged Items" />

            <Button fx:id="PurchaseOrders" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Purchase Orders" />

            <Button fx:id="CustomerOrders" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Customer Orders" />

            <Button fx:id="Payment" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Payment" />

            <Button fx:id="BundleOffers" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Bundle Offers" />

            <Button fx:id="CreditPayments" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Credit Payments" />

            <Button fx:id="Photocopying" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Photocopying" />

            <Button fx:id="DataReload" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Data Reload" />

            <Button fx:id="Expenses" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;" 
                    text="Expenses" />

            <Button fx:id="Customers" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Customers" />

            <Button fx:id="Suppliers" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-cursor: hand;"
                    text="Suppliers" />

            <Pane VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutButton" prefHeight="40" prefWidth="260" maxWidth="Infinity"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-cursor: hand;"
                    text="Logout" />
        </VBox>
    </left>

    <top>
        <HBox prefHeight="60" style="-fx-background-color: #34495E; -fx-padding: 10;">
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="Dashboard Overview" />
        </HBox>
    </top>

    <center>
        <Pane fx:id="contentPane" style="-fx-background-color: #ECF0F1;">
            <VBox alignment="CENTER" layoutX="0" layoutY="50" prefHeight="500" prefWidth="800" spacing="40">
            </VBox>
        </Pane>
    </center>

</BorderPane>
