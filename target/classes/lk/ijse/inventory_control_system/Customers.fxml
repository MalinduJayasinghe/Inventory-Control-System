<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550" prefWidth="900" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.inventory_control_system.controllers.CustomersController">

    <!-- Top Header -->
    <HBox layoutX="0" layoutY="0" prefHeight="60" prefWidth="900" style="-fx-background-color: #2C3E50; -fx-padding: 10;">
        <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="Customer Management" />
        </children>
    </HBox>

    <!-- Main Content -->
    <HBox layoutX="10" layoutY="70" spacing="20">

        <!-- Left Form -->
        <VBox prefWidth="300" spacing="12">

            <Label text="Search with Customer ID:" />
            <TextField fx:id="customerIDField" editable="true" onKeyPressed="#handleSearchCustomer" promptText="Enter Customer ID" />

            <Label text="Customer Name:" />
            <TextField fx:id="customerNameField" promptText="Enter Customer Name" />

            <Label text="Address:" />
            <TextField fx:id="addressField" promptText="Enter Address" />

            <Label text="Contact Number:" />
            <TextField fx:id="contactNumberField" promptText="Enter Contact Number" />

            <HBox spacing="10">
                <Button fx:id="saveBtn" onAction="#saveCustomer" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save" />
                <Button fx:id="updateBtn" onAction="#updateCustomer" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Update" />
                <Button fx:id="deleteBtn" onAction="#deleteCustomer" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete" />
            </HBox>

            <Button onAction="#resetFields" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" text="Clear Fields" />

        </VBox>

        <!-- Right Table -->
        <TableView fx:id="customersTable" prefHeight="400" prefWidth="550">
            <columns>
                <TableColumn fx:id="colCustomerID" prefWidth="100" text="Customer ID" />
                <TableColumn fx:id="colCustomerName" prefWidth="150" text="Name" />
                <TableColumn fx:id="colAddress" prefWidth="150" text="Address" />
                <TableColumn fx:id="colContact" prefWidth="150" text="Contact Number" />
            </columns>
        </TableView>

    </HBox>
</AnchorPane>
