<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640" prefWidth="880" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.inventory_control_system.controllers.CustomersController">
    
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #f1f5f9; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox spacing="18" style="-fx-padding: 20;">
                
                <!-- Customer Form Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 18px; -fx-font-weight: bold;" text="👥 Customer Information" />
                    
                    <HBox spacing="20">
                        
                        <!-- Left Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Search Customer -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Search for Customer" />
                                <ComboBox fx:id="customerIDField" maxWidth="250.0" onAction="#handleSearchCustomer" prefHeight="32" promptText="Select Customer" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Customer Name -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Customer Name" />
                                <TextField fx:id="customerNameField" maxWidth="250.0" prefHeight="32" promptText="Enter Customer Name" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                        </VBox>
                        
                        <!-- Right Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Address -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Address" />
                                <TextField fx:id="addressField" maxWidth="250.0" prefHeight="32" promptText="Enter Address" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Contact Number -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Contact Number" />
                                <TextField fx:id="contactNumberField" maxWidth="250.0" prefHeight="32" promptText="Enter Contact Number" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                        </VBox>
                        
                    </HBox>
                    
                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox.margin>
                            <Insets top="5" />
                        </VBox.margin>
                        
                        <Button fx:id="saveBtn" onAction="#saveCustomer" prefHeight="34" prefWidth="90" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Save" />
                        
                        <Button fx:id="updateBtn" onAction="#updateCustomer" prefHeight="34" prefWidth="90" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="✏️ Update" />
                        
                        <Button fx:id="deleteBtn" onAction="#deleteCustomer" prefHeight="34" prefWidth="90" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ Delete" />
                        
                        <Button onAction="#resetFields" prefHeight="34" prefWidth="110" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Clear Fields" />
                        
                    </HBox>
                    
                </VBox>
                
                <!-- Customers Table Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 16px; -fx-font-weight: bold;" text="📋 Customer List" />
                    
                    <TableView fx:id="customersTable" prefHeight="280" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="colCustomerID" prefWidth="120" style="-fx-alignment: CENTER;" text="Customer ID" />
                            <TableColumn fx:id="colCustomerName" prefWidth="220" style="-fx-alignment: CENTER-LEFT;" text="Name" />
                            <TableColumn fx:id="colAddress" prefWidth="260" style="-fx-alignment: CENTER-LEFT;" text="Address" />
                            <TableColumn fx:id="colContact" prefWidth="210" style="-fx-alignment: CENTER;" text="Contact Number" />
                        </columns>
                    </TableView>
                    
                </VBox>
                
            </VBox>
        </content>
    </ScrollPane>
    
</AnchorPane>
