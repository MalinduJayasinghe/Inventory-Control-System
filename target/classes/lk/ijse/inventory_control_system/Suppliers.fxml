<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="880.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.inventory_control_system.controllers.SuppliersController">

    <children>
        <VBox spacing="15" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
         <HBox prefHeight="45.0" prefWidth="779.0" style="-fx-background-color: #2C3E50;">
            <children>
      
                  <!-- Title -->
                  <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="  Manage Suppliers" textFill="#f7f7f7" />
            </children>
         </HBox>

            <HBox spacing="20">
                
                <!-- Left Form -->
                <VBox prefWidth="300" spacing="12">

                    <Label text="Supplier ID:" />
                    <TextField fx:id="supplierIDField" onKeyPressed="#searchSupplier" promptText="Enter Supplier ID" />

                    <Label text="Supplier Name:" />
                    <TextField fx:id="supplierNameField" promptText="Enter Supplier Name" />

                    <Label text="Address:" />
                    <TextField fx:id="addressField" promptText="Enter Address" />

                    <Label text="Email:" />
                    <TextField fx:id="emailField" promptText="Enter Email" />

                    <Label text="Contact Number:" />
                    <TextField fx:id="contactNumberField" promptText="Enter Contact Number" />

                    <HBox spacing="10">
                        <Button fx:id="saveBtn" onAction="#saveSupplier" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save" />
                        <Button fx:id="updateBtn" onAction="#updateSupplier" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Update" />
                        <Button fx:id="deleteBtn" onAction="#deleteSupplier" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Delete" />
                    </HBox>

                    <Button onAction="#resetFields" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;" text="Clear Fields" />

                </VBox>

                <!-- Table -->
                <TableView fx:id="suppliersTable" onKeyPressed="#searchSupplier" prefHeight="400.0" prefWidth="675.0">
                    <columns>
                        <TableColumn fx:id="colSupplierID" prefWidth="90" text="Supplier ID" />
                        <TableColumn fx:id="colSupplierName" prefWidth="120" text="Name" />
                        <TableColumn fx:id="colAddress" prefWidth="140" text="Address" />
                        <TableColumn fx:id="colEmail" prefWidth="140" text="Email" />
                        <TableColumn fx:id="colContact" prefWidth="120" text="Contact" />
                    </columns>
                </TableView>

            </HBox>
        </VBox>
    </children>

</AnchorPane>
