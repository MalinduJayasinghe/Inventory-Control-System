<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640" prefWidth="880" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.inventory_control_system.controllers.ItemsController">
    
    <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #f1f5f9; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox spacing="18" style="-fx-padding: 20;">
                
                <!-- Item Form Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 18px; -fx-font-weight: bold;" text="📦 Item Information" />
                    
                    <HBox spacing="20">
                        
                        <!-- Left Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Search Item -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Search for Item" />
                                <ComboBox fx:id="itemComboBox" maxWidth="250.0" onAction="#searchItem" prefHeight="32" promptText="Select Item" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Item Name -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Item Name" />
                                <TextField fx:id="itemNameField" maxWidth="250.0" prefHeight="32" promptText="Enter Item Name" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Quantity -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Quantity" />
                                <TextField fx:id="itemQuantityField" maxWidth="250.0" prefHeight="32" promptText="Enter Quantity" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                        </VBox>
                        
                        <!-- Right Column -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS">
                            
                            <!-- Unit Price -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Unit Price" />
                                <TextField fx:id="unitPriceField" maxWidth="250.0" prefHeight="32" promptText="Enter Unit Price" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Category -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Category" />
                                <TextField fx:id="categoryField" maxWidth="250.0" prefHeight="32" promptText="Enter Category" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                            <!-- Supplier -->
                            <VBox spacing="6">
                                <Label style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;" text="Supplier" />
                                <ComboBox fx:id="supplierComboBox" maxWidth="250.0" prefHeight="32" promptText="Select Supplier" style="-fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-padding: 6; -fx-font-size: 12px; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-border-width: 1;" />
                            </VBox>
                            
                        </VBox>
                        
                    </HBox>
                    
                    <!-- Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox.margin>
                            <Insets top="5" />
                        </VBox.margin>
                        
                        <Button onAction="#saveItem" prefHeight="34" prefWidth="90" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Save" />
                        
                        <Button onAction="#updateItem" prefHeight="34" prefWidth="90" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="✏️ Update" />
                        
                        <Button onAction="#deleteItem" prefHeight="34" prefWidth="90" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ Delete" />
                        
                        <Button onAction="#resetFields" prefHeight="34" prefWidth="90" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-size: 12px; -fx-font-weight: bold; -fx-cursor: hand;" text="🔄 Reset" />
                        
                    </HBox>
                    
                </VBox>
                
                <!-- Items Table Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    
                    <Label style="-fx-text-fill: #1e293b; -fx-font-size: 16px; -fx-font-weight: bold;" text="📋 Items List" />
                    
                    <TableView fx:id="itemsTable" prefHeight="280" style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="colItemID" prefWidth="80" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="colItemName" prefWidth="200" style="-fx-alignment: CENTER-LEFT;" text="Name" />
                            <TableColumn fx:id="colQuantity" prefWidth="100" style="-fx-alignment: CENTER;" text="Qty" />
                            <TableColumn fx:id="colUnitPrice" prefWidth="120" style="-fx-alignment: CENTER;" text="Price" />
                            <TableColumn fx:id="colCategory" prefWidth="180" style="-fx-alignment: CENTER-LEFT;" text="Category" />
                            <TableColumn fx:id="colSupplierName" prefWidth="130" style="-fx-alignment: CENTER-LEFT;" text="Supplier" />
                        </columns>
                    </TableView>
                    
                </VBox>
                
            </VBox>
        </content>
    </ScrollPane>
    
</AnchorPane>
